# Server-only. No database or secret is needed to build a safe empty preview.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=

# Set to the actual canonical HTTPS origin before production build (no trailing path).
PUBLIC_SITE_URL=http://localhost:3000
# Single-operator admin. Generate salt:hash with scripts/hash-admin-password.mjs.
ADMIN_PASSWORD_SCRYPT=
ADMIN_SESSION_SECRET=
ADMIN_OPERATOR=operator
# At least 32 random characters; daily rate-limit hashes, not user profiles.
ANALYTICS_SALT=

# Optional extraction only. No LLM runs in public search or answer requests.
OPENAI_API_KEY=
EXTRACTION_MODEL=
CRAWLER_USER_AGENT=SakHaber/0.3 (+https://github.com/andaykhvc/news)
WORKER_CONCURRENCY=2
